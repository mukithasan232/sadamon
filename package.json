{
  "name": "shadamon-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace for Shadamon project",
  "workspaces": [
    "shadamon-Frontend",
    "shadamon-Admin",
    "shadamon-Backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w shadamon-backend\" \"npm run dev -w shadamon-frontend\" \"npm run dev -w shadamon-admin -- -p 3001\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
